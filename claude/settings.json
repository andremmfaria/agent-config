{
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "auto"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(*)",
      "Edit(~/.claude/projects/**/memory/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/caveman-inject.sh SessionStart",
            "statusMessage": "Loading caveman mode"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/compaction-context-injector.sh SessionStart",
            "statusMessage": "Re-injecting directives after compaction"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/caveman-inject.sh SubagentStart",
            "statusMessage": "Loading caveman mode"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/compaction-context-injector.sh SubagentStart",
            "statusMessage": "Re-injecting standing directives"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-usage-reminder.sh",
            "statusMessage": "Checking for delegation opportunities"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-destructive-bash.sh",
            "statusMessage": "Checking command safety"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-file-read-guard.sh",
            "statusMessage": "Checking file-read pattern"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/write-existing-file-guard.sh",
            "statusMessage": "Checking read-before-write"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/write-path-guard.sh",
            "statusMessage": "Checking write target path"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|mcp__.*fetch.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/webfetch-domain-guard.sh",
            "statusMessage": "Checking outbound fetch target"
          }
        ]
      },
      {
        "matcher": "SendMessage|mcp__.*(send|post|publish|email|slack|telegram|discord|tweet|comment|reply)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/outbound-guard.sh",
            "statusMessage": "Checking outbound message"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/auto-format.sh",
            "statusMessage": "Auto-formatting changed file"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/comment-checker.sh",
            "statusMessage": "Checking comments"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-notification.sh Stop",
            "statusMessage": "Notifying: turn complete"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-notification.sh Notification",
            "statusMessage": "Notifying: attention needed"
          }
        ]
      }
    ]
  }
}
