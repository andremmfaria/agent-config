# Local/private material. Keep secrets and memory out of this repo.
private/*
!private/README.md
*.local
*.local.*

# Runtime noise
.DS_Store
__pycache__/
*.pyc

# Machine-local sync state and backups
.sync-state/
backups/

# Vendored skill dependencies (regenerated by npm install / pip / venv on
# deploy, never committed) and the harness-managed synced/ skill directory
claude/skills/**/node_modules/
claude/skills/**/__pycache__/
claude/skills/**/.venv/
claude/skills/synced/
