{
  "version": 1,
  "defaults": {
    "security": "allowlist",
    "ask": "on-miss",
    "askFallback": "deny"
  },
  "agents": {
    "main": {
      "security": "allowlist",
      "allowlist": [
        {
          "pattern": "**/git",
          "argPattern": "^(?!.*\\b(push|clean)\\b)(?!.*\\breset\\b.*--hard).*$"
        },
        {
          "pattern": "**/rg"
        },
        {
          "pattern": "**/grep"
        },
        {
          "pattern": "**/ls"
        },
        {
          "pattern": "**/cat"
        },
        {
          "pattern": "**/head"
        },
        {
          "pattern": "**/tail"
        },
        {
          "pattern": "**/find",
          "argPattern": "^(?!.*-delete\\b)(?!.*-exec\\b)(?!.*-execdir\\b)(?!.*-fprint\\b).*$"
        },
        {
          "pattern": "**/wc"
        },
        {
          "pattern": "**/jq"
        },
        {
          "pattern": "**/python3",
          "argPattern": "^(test|build|run|--version|list|check)\\b.*$"
        },
        {
          "pattern": "**/node",
          "argPattern": "^(test|build|run|--version|list|check)\\b.*$"
        },
        {
          "pattern": "**/npm",
